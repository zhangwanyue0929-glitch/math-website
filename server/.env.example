# 复制本文件为 server/.env 后再启动。
# 下面的口令只给本机答辩和课程演示用，不是可以公开部署的密码。
# 放到校园服务器或公网之前，请改掉 SESSION_SECRET、数据库密码和管理员密码。

PORT=3000

# MySQL 8。密码里如果有 @ # 等符号，要先做 URL 编码。
DATABASE_URL="mysql://suanjing:suanjing_local@127.0.0.1:3306/suanjing"

# 随便一长串即可。用来给会话签名，泄露后别人可以伪造登录状态。
SESSION_SECRET="dev-only-change-this-session-secret"

# 只有 https 站点才设为 true。本机 http://localhost 保持 false。
COOKIE_SECURE="false"

# 仅当管理员账号还不存在时，种子脚本会用这三行创建它。
# 再次运行种子不会覆盖已经改过的管理员密码。
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="Suanjing-Admin-2026"
SEED_ADMIN_EMAIL="admin@suanjing.local"
SEED_ADMIN_QUESTION="本馆的馆名是什么"
SEED_ADMIN_ANSWER="算经千年"
